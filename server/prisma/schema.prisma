generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRooms MeetingRoom[] @relation("RoomCreator")
  bookings     Booking[]
  roomMembers  RoomMember[]
}

model MeetingRoom {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User @relation("RoomCreator", fields: [createdById], references: [id])

  bookings Booking[]
  members  RoomMember[]
}

model RoomMember {
  id String @id @default(cuid())

  roomId String
  userId String

  role RoomRole @default(USER)

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Booking {
  id String @id @default(cuid())

  title       String
  description String?

  startTime DateTime
  endTime   DateTime

  roomId String
  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startTime, endTime])
}